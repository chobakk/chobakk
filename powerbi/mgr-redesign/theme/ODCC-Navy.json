{
  "name": "ODCC Navy",
  "dataColors": [
    "#2A5CAA",
    "#C8961E",
    "#6E9BE0",
    "#1F3864",
    "#5B6770",
    "#8EA9DB",
    "#7F8C9A",
    "#B4C6E7"
  ],
  "foreground": "#1B2A41",
  "foregroundNeutralSecondary": "#5B6770",
  "foregroundNeutralTertiary": "#9AA5B1",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F6F9",
  "backgroundNeutral": "#D9DEE7",
  "tableAccent": "#1F3864",
  "good": "#2E7D32",
  "neutral": "#D99A00",
  "bad": "#C0392B",
  "maximum": "#1F3864",
  "center": "#8EA9DB",
  "minimum": "#EEF2F8",
  "null": "#9AA5B1",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F3864"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F3864"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B2A41"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#5B6770"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F9"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E6EAF0"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D9DEE7"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 10,
            "right": 10
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1F3864"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1F3864"
              }
            },
            "fontSize": 26,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#5B6770"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F3864"
              }
            },
            "fontSize": 24,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "label": [
          {
            "fontColor": {
              "solid": {
                "color": "#5B6770"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E6EAF0"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#5B6770"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5B6770"
              }
            },
            "showAxisTitle": false
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 3
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#E6EAF0"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#E6EAF0"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E6EAF0"
              }
            },
            "gridVertical": false,
            "rowPadding": 4,
            "textSize": 10
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1F3864"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1B2A41"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F4F6F9"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F3864"
              }
            },
            "backColor": {
              "solid": {
                "color": "#E6EAF0"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1F3864"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1B2A41"
              }
            },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "backColorSecondary": {
              "solid": {
                "color": "#F4F6F9"
              }
            }
          }
        ],
        "subTotals": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F3864"
              }
            },
            "backColor": {
              "solid": {
                "color": "#E6EAF0"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F3864"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "textSize": 10
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1B2A41"
              }
            },
            "textSize": 10
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "image": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}